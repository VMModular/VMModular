{$DOMAIN} {
    # Basic Authentication (Excluding OPTIONS requests to prevent repetitive prompts)
    @not_options {
        not method OPTIONS
    }
    basic_auth @not_options {
        {$BASIC_AUTH_USER} {$BASIC_AUTH_PASS}
    }

    # Reverse proxy to the frontend container
    reverse_proxy vmcrm-frontend:80

    # Optional: Log to stdout
    log {
        output stdout
        format console
    }

    # Compress responses
    encode gzip zstd
}
